# Life OS — Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# LLM API (Abacus.AI RouteLLM)
ABACUSAI_API_KEY=your-api-key

# AWS S3 (file uploads)
AWS_BUCKET_NAME=your-bucket
AWS_REGION=us-east-1
AWS_FOLDER_PREFIX=lifeos/
AWS_PROFILE=default

# Google OAuth (optional, for Google SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notification IDs (Abacus notification API)
NOTIF_ID_MORNING_BRIEFING=
NOTIF_ID_EVENING_REFLECTION=

# App ID
WEB_APP_ID=
